# Optional: a free key increases the OpenAlex API budget. Never put it in VITE_*.
OPENALEX_API_KEY=
# Optional server-only Semantic Scholar API key. Never commit actual keys.
S2_API_KEY=
# Search default; graph provider always follows canonical paper IDs.
DEFAULT_PROVIDER=openalex
PORT=3001
HOST=127.0.0.1
# Set to 1 to prohibit provider traffic. S2 then requires its own cached data.
OFFLINE=0
