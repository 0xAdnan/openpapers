# Optional: a free key increases the paper metadata API budget. Never put it in VITE_*.
PAPERS_API_KEY=
# Optional server-only Semantic Scholar API key. Never commit actual keys.
S2_API_KEY=
# Search default; graph provider always follows canonical paper IDs.
DEFAULT_PROVIDER=openalex
DATABASE_URL=
GRAPH_WORKER_TOKEN=
# Default larger graph: 5k candidates, 100 requests; raise only within provider/storage budgets.
GRAPH_CANDIDATE_BUDGET=5000
GRAPH_REQUEST_BUDGET=100
GRAPH_DAILY_REQUEST_BUDGET=500
GRAPH_REFERENCE_BUDGET=500000
GRAPH_TOTAL_REFERENCE_BUDGET=1000000
PORT=3001
HOST=127.0.0.1
# Set to 1 to prohibit provider traffic. S2 then requires its own cached data.
OFFLINE=0
